{
  "name": "switchboard",
  "productName": "Switchboard",
  "version": "0.1.0",
  "description": "Discord, Mattermost and Teams in one window",
  "main": "main.js",
  "bin": {
    "sbmm": "cli/sbmm.js"
  },
  "private": true,
  "scripts": {
    "start": "electron .",
    "demo": "SWITCHBOARD_DEMO=1 electron .",
    "cli": "node cli/build.mjs",
    "package": "electron-packager . Switchboard --platform=darwin --arch=arm64 --out=dist --overwrite --ignore=^/dist --ignore=^/mobile --ignore=^/gmhelper",
    "postpackage": "codesign --force --deep --sign - dist/Switchboard-darwin-arm64/Switchboard.app"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@electron/packager": "18.3.6",
    "electron": "45.2.1",
    "esbuild": "^0.28.2"
  }
}
